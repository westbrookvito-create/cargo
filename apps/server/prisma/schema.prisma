generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ShipmentStatus {
  AWAITING_ARRIVAL
  IN_WAREHOUSE_CN
  PACKED
  IN_TRANSIT
  CUSTOMS
  IN_WAREHOUSE_LOCAL
  DELIVERED
  ISSUE
}

enum DeliveryMethod {
  AVIA
  AUTO
  EXPRESS
}

enum CargoCategory {
  GENERAL
  CLOTHES
  SHOES
  ELECTRONICS
  ACCESSORIES
  BATTERY
  LIQUID
  BRANDED
}

model User {
  id                   String     @id @default(cuid())
  telegramId           String     @unique
  firstName            String
  lastName             String?
  username             String?
  photoUrl             String?
  phone                String?
  languageCode         String     @default("ru")
  personalCode         String     @unique
  referralCode         String     @unique
  balanceUsd           Float      @default(0)
  notificationsEnabled Boolean    @default(true)
  createdAt            DateTime   @default(now())
  shipments            Shipment[]
}

model Shipment {
  id               String          @id @default(cuid())
  trackNumber      String          @unique
  cnTrackNumber    String?
  title            String
  storeName        String?
  category         CargoCategory   @default(GENERAL)
  status           ShipmentStatus  @default(AWAITING_ARRIVAL)
  deliveryMethod   DeliveryMethod  @default(AVIA)
  weightKg         Float?
  volumeM3         Float?
  declaredValueUsd Float?
  costUsd          Float?
  paid             Boolean         @default(false)
  etaDate          DateTime?
  photoUrl         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  events           TrackingEvent[]

  @@index([userId])
}

model TrackingEvent {
  id          String         @id @default(cuid())
  status      ShipmentStatus
  title       String
  description String?
  location    String?
  timestamp   DateTime       @default(now())
  shipmentId  String
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model Warehouse {
  id           String  @id @default(cuid())
  city         String
  cityRu       String
  country      String
  addressLines String
  isDefault    Boolean @default(false)
}

model Tariff {
  method        DeliveryMethod @id
  title         String
  subtitle      String
  pricePerKgUsd Float
  minDays       Int
  maxDays       Int
  minWeightKg   Float
}
