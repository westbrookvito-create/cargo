# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceWithReal

# Public URL of the deployed Mini App (must be https in production)
WEBAPP_URL=https://your-domain.example.com

# SQLite by default — swap for a Postgres/MySQL connection string in production
DATABASE_URL="file:./dev.db"

PORT=8080

# Comma-free origin allowed to call the API (your Mini App origin), or * for dev
CORS_ORIGIN=*

# Leave empty to run the bot in long-polling mode (fine for local dev).
# Set to your public HTTPS server URL to run it in webhook mode instead.
WEBHOOK_URL=

# Telegram username shown to users for manual support contact
SUPPORT_USERNAME=crispycargo_support

# When true, unauthenticated API requests are served as a fake dev user
# instead of being rejected — handy for curl/local testing. NEVER enable in production.
DEV_SKIP_AUTH=false
