# Token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to control the bot (you and any partners).
# Get your own ID by messaging @userinfobot.
OWNER_IDS=

# Where to store the SQLite database file.
DB_PATH=./data/bot.db

# Default number of days a subscriber must stay in the channel before it counts
# as a confirmed (paid) subscriber. Can be overridden per project.
DEFAULT_HOLD_DAYS=3

# Default currency label used when a new project is registered.
DEFAULT_CURRENCY=USD

# Bot's display name, set automatically on startup via the Bot API.
BOT_DISPLAY_NAME=Cherokky Traff

# What non-owner, non-project-owner users see when they message the bot.
GUEST_CONTACT=@saintsoon

# Optional: route Telegram API requests through a proxy, for networks where
# api.telegram.org is blocked/throttled directly. Examples:
#   BOT_PROXY_URL=socks5://user:pass@host:1080
#   BOT_PROXY_URL=http://user:pass@host:8080
BOT_PROXY_URL=
